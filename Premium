    <script>
        let activeBlobUrl = null;

        // Versatile Modal Logic
        function toggleModal(id, show) {
            document.getElementById(id).style.display = show ? 'flex' : 'none';
        }

        function confirmLaunch() {
            toggleModal('modalOverlay', false);
            launchCloaked();
        }

        function updatePing() {
            const start = Date.now();
            fetch(window.location.href, { mode: 'no-cors' }).then(() => {
                const delta = Date.now() - start;
                document.getElementById('ping').innerText = delta;
            }).catch(() => { document.getElementById('ping').innerText = '14'; });
        }
        setInterval(updatePing, 3000);
        updatePing();

        function generateBlob() {
            const currentContent = document.documentElement.outerHTML;
            const blob = new Blob([currentContent], { type: 'text/html' });
            if (activeBlobUrl) URL.revokeObjectURL(activeBlobUrl);
            activeBlobUrl = URL.createObjectURL(blob);
            document.getElementById('blobUrlDisplay').innerText = activeBlobUrl;
            document.getElementById('revokeBtn').style.display = 'inline-block';
            window.open(activeBlobUrl, '_blank');
        }

        function revokeBlob() {
            if (activeBlobUrl) {
                URL.revokeObjectURL(activeBlobUrl);
                activeBlobUrl = null;
                document.getElementById('blobUrlDisplay').innerText = 'URL Revoked';
                document.getElementById('revokeBtn').style.display = 'none';
            }
        }

        function launchCloaked(isBlob = false) {
            let targetDoc;
            if (isBlob) {
                targetDoc = document;
            } else {
                const win = window.open();
                if (!win) {
                    alert("Pop-up blocked! Please allow pop-ups for this site.");
                    return;
                }
                win.document.title = "Google Classroom"; 
                targetDoc = win.document;
            }
            
            const iframe = targetDoc.createElement('iframe');
            const mainHtml = `
            <!DOCTYPE html>
            <html>
            <head>
                <title>UGS Files</title>
                <style>
                    body { font-family: Tahoma, Verdana, sans-serif; background-color: #000000; color: #ffffff; margin: 0; display: flex; min-height: 100vh; overflow-y: auto; }
                    .sidebar { position: fixed; left: 0; top: 0; width: 80px; height: 100vh; background: #0a0a0a; border-right: 1px solid #1a1a1a; padding: 20px 10px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; box-sizing: border-box; z-index: 10; }
                    .sidebar-btn { background: #111; border: 1px solid #222; color: #fff; padding: 12px; font-weight: bold; border-radius: 4px; cursor: pointer; text-align: center; flex-shrink: 0; }
                    .sidebar-btn:hover { border-color: #fff; }
                    .main-content { margin-left: 80px; padding: 40px; flex: 1; min-height: 100vh; overflow-y: auto; }
                    h1 { font-size: 2.5rem; letter-spacing: -1px; margin-bottom: 20px; color: #ffffff; }
                    input[type="text"] { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 15px; width: 100%; max-width: 500px; color: white; margin-bottom: 30px; font-family: inherit; }
                    .letter-header { color: #ffffff; font-size: 22px; border-bottom: 1px solid #1a1a1a; margin: 30px 0 15px 0; }
                    input[type="button"] { background: #0a0a0a; border: 1px solid #1a1a1a; color: #ffffff; padding: 12px 20px; width: 100%; max-width: 700px; text-align: left; margin-bottom: 8px; cursor: pointer; transition: 0.2s; font-family: inherit; }
                    input[type="button"]:hover { background: #111; border-color: #fff; }
                </style>
            </head>
            <body>
                <div class="sidebar" id="sidebar"></div>
                <div class="main-content">
                    <h1>UGS FILES</h1>
                    <input type="text" placeholder="Search files :3" id="searchInput">
                    <div id="sections-container"></div>
                </div>
                <script src="https://cdn.jsdelivr.net/gh/mcgee1717/994894838923761723@main/searchbut.js"><\/script>
                <script src="https://cdn.jsdelivr.net/gh/mcgee1717/994894838923761723@49119bc/games.js"><\/script>
            </body>
            </html>`;

            iframe.style.width = '100%';
            iframe.style.height = '100%';
            iframe.style.border = 'none';
            iframe.style.position = 'fixed';
            iframe.style.inset = '0';
            
            targetDoc.body.innerHTML = '';
            targetDoc.body.style.margin = '0';
            targetDoc.body.appendChild(iframe);
            
            iframe.contentWindow.document.open();
            iframe.contentWindow.document.write(mainHtml);
            iframe.contentWindow.document.close();
        }
    </script>
