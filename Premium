<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UGS | AMOLED Launcher</title>
    <style>
        :root {
            --bg-color: #000000;
            --accent-color: #ffffff; 
            --card-bg: #0a0a0a;
            --border-color: #1a1a1a;
            --text-main: #ffffff;
            --text-dim: #bbbbbb;
            --error-color: #ff3333; 
        }

        body, html {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: Tahoma, Verdana, sans-serif;
            min-height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-y: auto; 
        }

        /* --- MODAL STYLES --- */
        .modal-overlay {
            display: none; 
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6); 
            backdrop-filter: blur(10px); 
            -webkit-backdrop-filter: blur(10px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 30px;
            width: 350px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            border-radius: 4px;
        }

        .modal-box h2 {
            margin-top: 0;
            font-size: 18px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .modal-box p {
            color: var(--text-dim);
            font-size: 13px;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        .modal-btns {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn-modal-confirm {
            background: #ffffff;
            color: #000;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
        }

        .btn-modal-cancel {
            background: transparent;
            color: #fff;
            border: 1px solid #333;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 12px;
        }
        /* --- END MODAL STYLES --- */

        .status-box, .blob-control-box {
            position: absolute;
            top: 20px;
            padding: 10px;
            border: 1px solid var(--text-dim);
            color: var(--text-main);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            background: rgba(255, 255, 255, 0.05);
        }

        .status-box { left: 20px; text-align: left; }
        .blob-control-box { right: 20px; text-align: right; min-width: 150px; }

        .blob-link {
            display: block;
            color: var(--text-dim);
            text-decoration: none;
            font-size: 10px;
            margin: 5px 0;
            word-break: break-all;
            font-family: monospace;
            text-transform: none;
            letter-spacing: 0;
        }

        .btn-action {
            color: var(--text-main);
            text-decoration: none;
            font-size: 12px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            font-family: inherit;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
        }

        .btn-revoke { color: var(--error-color); margin-top: 5px; display: none; }

        .settings-corner {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 35px;
            height: 35px;
            cursor: pointer;
            z-index: 100;
            transition: transform 0.4s ease, opacity 0.3s ease;
            opacity: 0.6;
            filter: invert(1);
        }

        .settings-corner:hover {
            transform: rotate(90deg);
            opacity: 1;
        }

        .launch-center {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 0; 
        }

        .ascii-art {
            font-family: monospace;
            font-size: 8px;
            line-height: 1.2;
            color: var(--text-main);
            white-space: pre;
            margin-bottom: 20px;
            pointer-events: none;
            user-select: none;
            transform: scale(0.8);
        }

        @media (min-width: 800px) {
            .ascii-art { font-size: 10px; transform: scale(1); }
        }

        .launch-subtitle {
            color: var(--text-dim);
            font-size: 14px;
            margin-bottom: 30px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .btn-launch {
            background: transparent;
            border: 1px solid var(--text-main);
            color: var(--text-main);
            padding: 15px 50px;
            font-size: 18px;
            font-family: Tahoma, sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-launch:hover {
            background: var(--text-main);
            color: var(--bg-color);
        }
    </style>
</head>
